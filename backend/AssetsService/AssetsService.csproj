<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Genera el archivo XML con los comentarios /// para que Swagger los muestre -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- No molesta con warnings por falta de comentarios XML en todo el codigo -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- Migracion a Onion: los 4 proyectos nuevos viven dentro de esta carpeta.
       El globbing por defecto (**/*.cs) los absorberia; se excluyen hasta que
       este proyecto viejo se elimine al terminar la migracion. -->
  <ItemGroup>
    <Compile Remove="AssetsService.Domain/**" />
    <Compile Remove="AssetsService.Application/**" />
    <Compile Remove="AssetsService.Infrastructure/**" />
    <Compile Remove="AssetsService.Api/**" />
    <Content Remove="AssetsService.Domain/**" />
    <Content Remove="AssetsService.Application/**" />
    <Content Remove="AssetsService.Infrastructure/**" />
    <Content Remove="AssetsService.Api/**" />
    <None Remove="AssetsService.Domain/**" />
    <None Remove="AssetsService.Application/**" />
    <None Remove="AssetsService.Infrastructure/**" />
    <None Remove="AssetsService.Api/**" />
  </ItemGroup>

</Project>
